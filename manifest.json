{
  "manifest_version": 3,
  "name": "ProdTab",
  "version": "3.1.0",
  "description": "ProdTab is a customizable browser startpage with onboarding, dynamic city weather, editable bookmarks, and light/dark themes, inspired by snes19xx.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  },
  "permissions": ["search"],
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png",
    "128": "assets/icons/icon-128.png"
  },
  "author": "tribejustice35@gmail.com",
  "homepage_url": "https://github.com/Aarav2709/ProdTab",
  "browser_specific_settings": {
    "gecko": {
      "id": "{fbbaa869-22c1-452a-bc1d-6a019aac9de8}",
      "data_collection_permissions": {
        "required": ["locationInfo"]
      }
    }
  }
}
